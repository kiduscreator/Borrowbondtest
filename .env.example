# GEMINI_API_KEY: Server-only API key for Gemini AI Borrowing & Security Agents.
# AI Studio automatically injects this at runtime from user secrets.
# Never expose with VITE_ or NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=""

# APP_URL: Public origin URL where BorrowBond is hosted (used for OAuth redirect allowlist & CSRF checks).
APP_URL="http://localhost:3000"

# SESSION_SECRET: Server-only 32+ byte secret used to sign HttpOnly session cookies and NEP-413 challenges.
SESSION_SECRET=""

# NEAR Testnet Configuration (Client-safe public identifiers):
VITE_NEAR_NETWORK_ID="testnet"
VITE_NEAR_CONTRACT_ID="borrowbondtest.testnet"
VITE_NEAR_RPC_URL="https://test.rpc.fastnear.com"
VITE_NEAR_EXPLORER_URL="https://testnet.nearblocks.io"
VITE_NEAR_TREASURY_ACCOUNT_ID="treasury.borrowbond.testnet"
NEAR_RESOLVER_ACCOUNT_ID="resolver.borrowbond.testnet"

# WalletConnect v2 Project ID (Client-safe public identifier):
VITE_WALLETCONNECT_PROJECT_ID=""

# Supabase Auth & Database Configuration:
# Only VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY may be exposed to the browser; SUPABASE_SERVICE_ROLE_KEY is server-only.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# Google OAuth 2.0 Server Configuration (Server-only secret):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Digital Resource Gateway Signing Secret (Server-only):
API_GATEWAY_SECRET=""
